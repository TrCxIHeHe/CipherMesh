{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ciphermesh_frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "ciphermesh_backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "ciphermesh_backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "ciphermesh_frontend"
      }
    }
  ]
}
